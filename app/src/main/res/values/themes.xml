<resources>

    <style name="Theme.BmwLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- v4.0: the system's own cold-start window must not flash a picture/logo. -->
        <item name="android:windowDisablePreview">true</item>
        <item name="colorAccent">@color/m_blue</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!--
      v4.0: the launcher entry point uses a black, icon-less starting window. On Android 12+ the
      platform always draws a splash screen; without this override it would show the app icon
      before the user's own boot video/picture, which is exactly the "unnecessary logo" the user
      asked to remove. The v31 folder replaces the splash attributes; older releases use the plain
      theme above.
    -->
    <style name="Theme.BmwLauncher.Splash" parent="Theme.BmwLauncher" />

    <style name="Theme.BmwLauncher.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorAccent">@color/m_blue</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="DockButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:background">@drawable/bg_dock_button</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>

</resources>
