<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the in-pane app picker: icon, Korean app name, package as small extra text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="10dp"
    android:paddingRight="8dp">

    <ImageView
        android:id="@+id/pickIcon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pickLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/pickPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/pickCurrent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="@string/picker_current"
        android:textColor="@color/m_light_blue"
        android:textSize="9sp"
        android:visibility="gone" />
</LinearLayout>
