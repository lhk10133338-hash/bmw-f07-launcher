<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="12dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_ratio_btn"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_engine" />

            <RadioGroup
                android:id="@+id/engineGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/engine_system"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbVirtual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/engine_virtual"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/engineDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/engine_system_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAccessibility"
                    style="@style/SettingsButton"
                    android:text="@string/perm_accessibility" />

                <TextView
                    android:id="@+id/btnOverlay"
                    style="@style/SettingsButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/perm_overlay" />

                <TextView
                    android:id="@+id/btnHelp"
                    style="@style/SettingsButton"
                    android:layout_marginStart="8dp"
                    android:text="도움말" />
            </LinearLayout>

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_ratio" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/ratioSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="60"
                    android:progress="30"
                    android:progressTint="@color/m_blue"
                    android:thumbTint="@color/m_blue" />

                <TextView
                    android:id="@+id/ratioValue"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="5 : 5"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_dpi" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="왼쪽"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/leftDpiSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="36"
                    android:progressTint="@color/m_blue"
                    android:thumbTint="@color/m_blue" />

                <TextView
                    android:id="@+id/leftDpiValue"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="240 dpi"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="오른쪽"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/rightDpiSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="36"
                    android:progressTint="@color/m_blue"
                    android:thumbTint="@color/m_blue" />

                <TextView
                    android:id="@+id/rightDpiValue"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="240 dpi"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="좁은 창(2:8)에서 앱 글자가 너무 크면 DPI를 낮추고, 너무 작으면 높이세요. 가상 디스플레이 모드에서 적용됩니다."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_presets" />

            <LinearLayout
                android:id="@+id/presetList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_intro" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/intro_enabled"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchSkipReturn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/intro_skip_return"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvVideoName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/intro_video_none"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPickVideo"
                    style="@style/SettingsButton"
                    android:text="@string/intro_pick_video" />

                <TextView
                    android:id="@+id/btnResetVideo"
                    style="@style/SettingsButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/intro_reset_video" />
            </LinearLayout>

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_dock" />

            <RadioGroup
                android:id="@+id/dockGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbDockBottom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dock_bottom"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbDockLeft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dock_left"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </RadioGroup>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAutoHide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/dock_auto_hide"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_permissions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnHome"
                    style="@style/SettingsButton"
                    android:text="@string/perm_home" />

                <TextView
                    android:id="@+id/btnHidden"
                    style="@style/SettingsButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/perm_hidden_apps" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="20dp"
                android:text="BMW F07 Launcher v1.0 · 2560×720 / Android 14"
                android:textColor="#FF4A4A4A"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
