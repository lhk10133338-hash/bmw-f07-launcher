<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_dock_button"
            android:clickable="true"
            android:contentDescription="@string/close"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="4dp"
            android:paddingRight="14dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_start" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchRememberSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/switch_remember_session"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchBoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/switch_boot"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/intro_enabled"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchSkipReturn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/intro_skip_return"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvVideoName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/intro_video_none"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPickVideo"
                    style="@style/SettingsButton"
                    android:text="@string/intro_pick_video" />

                <TextView
                    android:id="@+id/btnResetVideo"
                    style="@style/SettingsButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/intro_reset_video" />
            </LinearLayout>

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_engine" />

            <RadioGroup
                android:id="@+id/engineGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="@string/engine_system"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbVirtual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="@string/engine_virtual"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/engineDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/engine_system_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- v3.4: Shizuku runs the touch service that lets the virtual-display panes be used. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnShizuku"
                    style="@style/SettingsButton"
                    android:text="@string/perm_shizuku" />

                <TextView
                    android:id="@+id/tvShizukuStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/shizuku_not_running"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAccessibility"
                    style="@style/SettingsButton"
                    android:text="@string/perm_accessibility" />

                <TextView
                    android:id="@+id/btnOverlay"
                    style="@style/SettingsButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/perm_overlay" />

                <TextView
                    android:id="@+id/btnHelp"
                    style="@style/SettingsButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/perm_help" />
            </LinearLayout>

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_ratio" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/ratioSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="60"
                    android:progress="30"
                    android:progressTint="@color/m_blue"
                    android:thumbTint="@color/m_blue" />

                <TextView
                    android:id="@+id/ratioValue"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="5 : 5"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_dpi" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="wrap_content"
                    android:text="@string/pane_left"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/leftDpiSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="38"
                    android:progressTint="@color/m_blue"
                    android:thumbTint="@color/m_blue" />

                <TextView
                    android:id="@+id/leftDpiValue"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="240 dpi"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="wrap_content"
                    android:text="@string/pane_right"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/rightDpiSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="38"
                    android:progressTint="@color/m_blue"
                    android:thumbTint="@color/m_blue" />

                <TextView
                    android:id="@+id/rightDpiValue"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="240 dpi"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="기본 200 dpi. 2:8처럼 좁은 창에서 앱 글자가 크면 120~160까지 낮추세요. 가상 디스플레이 방식에서만 적용됩니다(시스템 자유창은 기기 기본 DPI)."
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_launcher_scale" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/launcherScaleSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="13"
                    android:progress="7"
                    android:progressTint="@color/m_blue"
                    android:thumbTint="@color/m_blue" />

                <TextView
                    android:id="@+id/launcherScaleValue"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="100%"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/launcherScaleHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/launcher_scale_hint"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_music" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPickMusic"
                    style="@style/SettingsButton"
                    android:text="@string/music_pick" />

                <TextView
                    android:id="@+id/btnClearMusic"
                    style="@style/SettingsButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/music_none" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMusicApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAutoPlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="2dp"
                android:text="@string/switch_auto_play"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/music_hint"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_presets" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnImportDefaults"
                    style="@style/SettingsButton"
                    android:text="@string/btn_import_defaults" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/presetList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_dock" />

            <RadioGroup
                android:id="@+id/dockGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbDockLeft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dock_left"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbDockRight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dock_right"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </RadioGroup>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAutoHide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/switch_dock_auto_hide"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_permissions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnHome"
                    style="@style/SettingsButton"
                    android:text="@string/perm_home" />

                <TextView
                    android:id="@+id/btnHidden"
                    style="@style/SettingsButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/perm_hidden_apps" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="BMW F07 Launcher v2.1 · 2560×720 / Android 14"
                android:textColor="#FF4A4A4A"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
