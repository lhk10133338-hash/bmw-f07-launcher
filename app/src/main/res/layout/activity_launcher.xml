<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:id="@+id/rootRow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Slim left dock: clock, saved split presets, save, app drawer, settings. -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_dock"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clockText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="8sp" />

            <View
                android:layout_width="16dp"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:background="@color/m_blue" />

            <ScrollView
                android:id="@+id/presetScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/presetList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/dockSave"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_plus_box"
                android:clickable="true"
                android:contentDescription="@string/dock_save"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFAFAFAF"
                android:textSize="20sp" />

            <View
                android:layout_width="30dp"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_line" />

            <ImageView
                android:id="@+id/dockDrawer"
                style="@style/DockIcon"
                android:layout_marginTop="2dp"
                android:contentDescription="@string/dock_apps"
                android:src="@drawable/ic_apps" />

            <ImageView
                android:id="@+id/dockSettings"
                style="@style/DockIcon"
                android:contentDescription="@string/dock_settings"
                android:src="@drawable/ic_settings" />

            <TextView
                android:id="@+id/dockHide"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginBottom="2dp"
                android:clickable="true"
                android:contentDescription="@string/dock_hide"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <com.hyteck.bmwf07launcher.ui.SplitLayout
            android:id="@+id/split"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/leftPane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pane">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/leftContent"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <SurfaceView
                            android:id="@+id/leftSurface"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:id="@+id/leftEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/black"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:background="@drawable/bg_plus_box">

                                <ImageView
                                    android:id="@+id/leftEmptyIcon"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@string/app_add"
                                    android:src="@drawable/ic_plus" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/leftEmptyTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:text="@string/app_add"
                                android:textColor="#FFC6C6C6"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/leftEmptyHint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/app_add_hint"
                                android:textColor="#FF5C5C5C"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <com.hyteck.bmwf07launcher.ui.PaneHandle
                        android:id="@+id/leftHandle"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:contentDescription="@string/pane_handle_hint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/leftFullExit"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:text="@string/pane_restore"
                    android:textColor="@color/text_primary"
                    android:textSize="9sp"
                    android:visibility="gone" />

                <!-- Menu / app picker of THIS pane. It is a child of the pane, so it can only
                     ever be drawn inside the pane's own rectangle and never over the neighbour. -->
                <FrameLayout
                    android:id="@+id/leftOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/black"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />
            </FrameLayout>

            <com.hyteck.bmwf07launcher.ui.DividerView
                android:id="@+id/divider"
                android:layout_width="12dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/ratio_title" />

            <FrameLayout
                android:id="@+id/rightPane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pane">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/rightContent"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <SurfaceView
                            android:id="@+id/rightSurface"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:id="@+id/rightEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/black"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:background="@drawable/bg_plus_box">

                                <ImageView
                                    android:id="@+id/rightEmptyIcon"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@string/app_add"
                                    android:src="@drawable/ic_plus" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/rightEmptyTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:text="@string/app_add"
                                android:textColor="#FFC6C6C6"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/rightEmptyHint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/app_add_hint"
                                android:textColor="#FF5C5C5C"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <com.hyteck.bmwf07launcher.ui.PaneHandle
                        android:id="@+id/rightHandle"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:contentDescription="@string/pane_handle_hint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/rightFullExit"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:text="@string/pane_restore"
                    android:textColor="@color/text_primary"
                    android:textSize="9sp"
                    android:visibility="gone" />

                <!-- Menu / app picker of THIS pane (see leftOverlay). -->
                <FrameLayout
                    android:id="@+id/rightOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/black"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />
            </FrameLayout>
        </com.hyteck.bmwf07launcher.ui.SplitLayout>
    </LinearLayout>

    <!-- Edge handle: only while the dock is hidden. -->
    <FrameLayout
        android:id="@+id/dockEdge"
        android:layout_width="18dp"
        android:layout_height="220dp"
        android:layout_gravity="start|center_vertical"
        android:clickable="true"
        android:contentDescription="@string/dock_show"
        android:focusable="true"
        android:visibility="gone">

        <View
            android:layout_width="3dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_divider_handle" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/introLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone">

        <com.hyteck.bmwf07launcher.ui.IntroView
            android:id="@+id/introView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.hyteck.bmwf07launcher.ui.CroppedVideoView
            android:id="@+id/introVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
