<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:id="@+id/mainColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="8dp">

            <TextView
                android:id="@+id/clockText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/ratioGroup"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/btnSwap"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_ratio_btn"
                android:gravity="center"
                android:text="⇄"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnLeftFull"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_ratio_btn"
                android:gravity="center"
                android:text="◧"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/btnRightFull"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_ratio_btn"
                android:gravity="center"
                android:text="◨"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/btnCloseFull"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_ratio_btn_on"
                android:gravity="center"
                android:text="▣"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/paneRow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/leftPane"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_pane">

                <SurfaceView
                    android:id="@+id/leftSurface"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/leftEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/leftEmptyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="왼쪽 창\n앱을 선택하세요"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/divider"
                android:layout_width="14dp"
                android:layout_height="match_parent">

                <View
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_divider_handle" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/rightPane"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_pane">

                <SurfaceView
                    android:id="@+id/rightSurface"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/rightEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/rightEmptyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="오른쪽 창\n앱을 선택하세요"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_dock"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/dockPresets"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/dockDrawer"
            style="@style/DockButton"
            android:drawableTop="@drawable/ic_apps"
            android:drawableTint="@color/text_primary"
            android:text="앱"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/dockSettings"
            style="@style/DockButton"
            android:drawableTop="@drawable/ic_settings"
            android:drawableTint="@color/text_primary"
            android:text="설정"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/introLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone">

        <com.hyteck.bmwf07launcher.ui.IntroView
            android:id="@+id/introView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <VideoView
            android:id="@+id/introVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/skipHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="36dp"
            android:alpha="0.55"
            android:text="@string/intro_skip_hint"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </FrameLayout>

</FrameLayout>
